{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynaprune.dev/schemas/receipt.schema.json",
  "title": "dynaprune verification receipt",
  "description": "One receipt per (point, stage, run). Append-only. A failed receipt is never deleted. Contains hashes and numbers only: no hostnames, IPs, paths or credentials. The receipt's own hash is its signature; independence is asserted by node_role.",
  "type": "object",
  "required": ["schema_version", "receipt_id", "point_id", "stage", "node_role", "inputs", "result", "environment", "started_at", "finished_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "receipt_id": { "$ref": "observation.schema.json#/$defs/sha256" },
    "point_id": { "type": "string" },
    "stage": { "type": "string", "enum": ["S0_ingest", "S1_freeze", "S2_derive", "S3_admit", "S4_quality", "S5_functional", "S6_speed", "S7_attest"], "description": "METHOD.md step ids." },
    "node_role": { "type": "string", "enum": ["derive", "quality", "serve", "attest"], "description": "Fleet role that produced this receipt. S7 receipts must come from attest." },
    "run_index": { "type": "integer", "minimum": 0, "description": "Cold-run index for stages repeated N times." },
    "inputs": {
      "type": "object",
      "required": ["plan_id"],
      "additionalProperties": false,
      "properties": {
        "plan_id": { "$ref": "observation.schema.json#/$defs/sha256" },
        "manifest_id": { "$ref": "observation.schema.json#/$defs/sha256" },
        "panel_sha256": { "$ref": "observation.schema.json#/$defs/sha256", "description": "Evaluation panel hash. Must differ from observation panel hash." },
        "teacher_sha256": { "$ref": "observation.schema.json#/$defs/sha256", "description": "Hash of the sealed teacher logits/reference used for teacher-forced KL." },
        "fixtures_sha256": { "$ref": "observation.schema.json#/$defs/sha256" },
        "control_point_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "required": ["passed"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "reason": { "type": "string", "description": "Required when passed is false." },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positions": { "type": "integer" },
            "kl_mean": { "type": "number" }, "kl_median": { "type": "number" }, "kl_p90": { "type": "number" },
            "top1_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
            "ppl": { "type": "number" },
            "kl_ci95": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "task_metrics": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        },
        "degeneration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loop_rate": { "type": "number", "description": "Fraction of fixed-payload generations that hit an exact token-id n-gram loop before normal stop." },
            "acceptance_exact_ids": { "type": "number", "description": "Fraction of fixture payloads whose emitted token ids equal the expected sequence." },
            "distinct_ngram_ratio": { "type": "number" }
          }
        },
        "speed": {
          "type": "array",
          "description": "Ladder cells. One row per (context_tokens, concurrency).",
          "items": {
            "type": "object",
            "required": ["context_tokens", "concurrency", "prefill_tok_s", "decode_tok_s"],
            "additionalProperties": false,
            "properties": {
              "context_tokens": { "type": "integer" }, "concurrency": { "type": "integer" },
              "prefill_tok_s": { "type": "number" }, "decode_tok_s": { "type": "number" },
              "decode_window_s": { "type": "number" }, "repeats": { "type": "integer" }, "mtp": { "type": "boolean" }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weights_resident_bytes": { "type": "integer" },
            "kv_bytes_at_max_context": { "type": "integer" },
            "graphs_bytes": { "type": "integer" },
            "kv_admission_tokens": { "type": "integer", "description": "Largest single request admitted without OOM." }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shards_verified": { "type": "integer" },
            "rederived_hashes_match": { "type": "boolean", "description": "S7: attest node re-derived from source + plan and compared every output hash." },
            "scrub_clean": { "type": "boolean", "description": "S7: no private hosts/paths/credentials found in publishable files." }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["image_digest", "engine"],
      "additionalProperties": false,
      "properties": {
        "image_digest": { "type": "string", "description": "Container image digest (sha256:...)." },
        "engine": { "type": "string", "description": "Engine name and version, e.g. sglang x.y.z." },
        "engine_args_sha256": { "$ref": "observation.schema.json#/$defs/sha256" },
        "gpu": { "type": "string", "description": "Device class only, e.g. GB10 sm121." },
        "harness_version": { "type": "string" },
        "lock_override": { "type": "boolean", "default": false, "description": "True if any pinned input was overridden; such receipts cannot publish." }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  },
  "if": { "properties": { "result": { "properties": { "passed": { "const": false } } } } },
  "then": { "properties": { "result": { "required": ["reason"] } } }
}
