{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynaprune.dev/schemas/manifest.schema.json",
  "title": "dynaprune derivation manifest",
  "description": "Written by the deriver next to the derived artifact. Ties output shards, byte-for-byte, to (source revision, plan, packer version). Anyone holding the public source and the plan can re-derive and compare output hashes without contacting the author.",
  "type": "object",
  "required": ["schema_version", "manifest_id", "point_id", "plan_id", "source", "packer", "outputs", "accounting", "config_patch", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "manifest_id": { "$ref": "observation.schema.json#/$defs/sha256" },
    "point_id": { "type": "string" },
    "plan_id": { "$ref": "observation.schema.json#/$defs/sha256" },
    "source": {
      "type": "object",
      "required": ["model", "shards"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "observation.schema.json#/$defs/modelRef" },
        "shards": { "type": "array", "items": { "$ref": "#/$defs/shard" } }
      }
    },
    "packer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "unit_family": { "type": "string", "description": "Plugin that performed the surgery, e.g. moe_expert." }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["shards", "index_sha256", "config_sha256"],
      "additionalProperties": false,
      "properties": {
        "shards": { "type": "array", "items": { "$ref": "#/$defs/shard" } },
        "index_sha256": { "$ref": "observation.schema.json#/$defs/sha256" },
        "config_sha256": { "$ref": "observation.schema.json#/$defs/sha256" },
        "total_bytes": { "type": "integer" }
      }
    },
    "accounting": {
      "type": "object",
      "required": ["expected_total", "actual_total", "protected_tensors_identical", "mapping_rows_verified"],
      "additionalProperties": false,
      "properties": {
        "expected_total": { "type": "integer", "description": "From plan.bytes.expected_total." },
        "actual_total": { "type": "integer" },
        "protected_tensors_identical": { "type": "boolean", "description": "Every non-pruned tensor is byte-identical to the source." },
        "mapping_rows_verified": { "type": "boolean", "description": "Router/mapping rows for retained ids equal the source rows at the original ids." },
        "per_layer": { "type": "array", "items": { "type": "object", "required": ["layer", "units", "bytes"], "properties": { "layer": { "type": "integer" }, "units": { "type": "integer" }, "bytes": { "type": "integer" } } } }
      }
    },
    "config_patch": {
      "type": "object",
      "description": "Keys written into the derived model config for engines. Never a mask.",
      "required": ["routed_units_per_layer", "retained_unit_ids_by_layer"],
      "additionalProperties": true,
      "properties": {
        "routed_units_per_layer": { "type": "array", "items": { "type": "integer" } },
        "retained_unit_ids_by_layer": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } } },
        "compensation": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["partial", "complete", "failed"], "description": "partial = resumable; completed shards are listed with hashes." },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "shard": {
      "type": "object",
      "required": ["file", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^[^/]+$", "description": "Basename only; no directories, no operator paths." },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "observation.schema.json#/$defs/sha256" }
      }
    }
  }
}
