{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynaprune.dev/schemas/frontier.schema.json",
  "title": "dynaprune published frontier",
  "description": "Append-only list of every measured point, ordered by bytes, with its receipts and the controls it was compared against. Losing points stay. The file carries no 'best' flag; status is the only judgement and it follows METHOD §6 rules mechanically.",
  "type": "object",
  "required": ["schema_version", "model", "points"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "model": { "$ref": "observation.schema.json#/$defs/modelRef" },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point_id", "plan_id", "manifest_id", "role", "tier", "prune_fraction", "total_bytes", "status", "receipt_ids", "control_point_ids"],
        "additionalProperties": false,
        "properties": {
          "point_id": { "type": "string" },
          "plan_id": { "$ref": "observation.schema.json#/$defs/sha256" },
          "manifest_id": { "$ref": "observation.schema.json#/$defs/sha256" },
          "role": { "type": "string" },
          "tier": { "type": "string" },
          "prune_fraction": { "type": "number" },
          "total_bytes": { "type": "integer" },
          "status": { "type": "string", "enum": ["planned", "derived", "candidate", "validated", "recommended", "rejected", "quarantined"] },
          "recommended_for": { "type": "array", "items": { "type": "string", "enum": ["token_fidelity", "task_metrics"] } },
          "receipt_ids": { "type": "array", "items": { "$ref": "observation.schema.json#/$defs/sha256" } },
          "control_point_ids": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "object", "description": "Copied numbers from receipts for display; receipts are authoritative.", "additionalProperties": { "type": "number" } }
        }
      }
    }
  }
}
