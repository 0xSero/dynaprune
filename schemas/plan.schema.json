{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynaprune.dev/schemas/plan.schema.json",
  "title": "dynaprune frozen pruning plan",
  "description": "Deterministic output of (observation set, policy, planner version). Frozen before any evaluation: plan_id is the hash of the file, the file is made read-only, and selection_uses_heldout is asserted false. The plan lists exactly which source-numbered units survive in each layer and the byte accounting that justifies it.",
  "type": "object",
  "required": ["schema_version", "plan_id", "point_id", "inputs", "unit_type", "layers", "bytes", "selection_uses_heldout", "role"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "$ref": "observation.schema.json#/$defs/sha256", "description": "SHA-256 of canonical JSON with this field blank." },
    "point_id": { "type": "string", "pattern": "^[a-z0-9.]+-[a-z0-9.]+-p[0-9]{3}-[a-z_]+-[a-f0-9]{8}$", "description": "{model_tag}-{tier}-p{prune_permille}-{ranker}-{plan_id[:8]}" },
    "role": { "type": "string", "enum": ["main", "equal_byte_demotion", "random_prune", "frequency_only", "unpruned_anchor", "uniform_prune"], "description": "main, or which control arm this plan realizes." },
    "inputs": {
      "type": "object",
      "required": ["observation_id", "policy_sha256", "planner_version", "model"],
      "additionalProperties": false,
      "properties": {
        "observation_id": { "$ref": "observation.schema.json#/$defs/sha256" },
        "policy_sha256": { "$ref": "observation.schema.json#/$defs/sha256" },
        "planner_version": { "type": "string" },
        "model": { "$ref": "observation.schema.json#/$defs/modelRef" },
        "seed": { "type": "integer" }
      }
    },
    "unit_type": { "$ref": "observation.schema.json#/$defs/unitType" },
    "block": { "type": "integer", "minimum": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "source_count", "keep_count", "retained_ids"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "integer", "minimum": 0 },
          "source_count": { "type": "integer", "minimum": 1 },
          "keep_count": { "type": "integer", "minimum": 1 },
          "retained_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true, "description": "Source-numbered ids, ascending. New id = position in this list (contiguous renumbering)." },
          "removal_order": { "type": "array", "items": { "type": "integer" }, "description": "Removed ids in the order the solver removed them; lets a reader reconstruct the greedy ledger." },
          "compensation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string" },
              "bias_vectors_sha256": { "$ref": "observation.schema.json#/$defs/sha256" }
            }
          }
        }
      }
    },
    "bytes": {
      "type": "object",
      "description": "Byte-exact accounting from safetensors headers, never from a model.",
      "required": ["source_total", "bytes_per_unit", "removed_units", "expected_total"],
      "additionalProperties": false,
      "properties": {
        "source_total": { "type": "integer" },
        "bytes_per_unit": { "type": "integer", "description": "Packed tensor bytes + router/mapping bytes per unit at this tier." },
        "removed_units": { "type": "integer" },
        "expected_total": { "type": "integer", "description": "source_total − removed_units × bytes_per_unit. Manifest must match exactly." },
        "budget_bytes": { "type": "integer" }
      }
    },
    "prune_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "selection_uses_heldout": { "const": false, "description": "Pre-registration assertion: no evaluation-panel feedback entered selection." },
    "frozen_at": { "type": "string", "format": "date-time" }
  }
}
